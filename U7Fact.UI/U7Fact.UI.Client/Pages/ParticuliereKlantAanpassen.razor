@page "/ParticuliereKlantAanpassen/{Id:int}"
@using U7Fact.Model
@using BlazorBootstrap
@using U7Fact.Services.Contracts
@inject IParticuliereKlantService ParticuliereKlantService
@inject NavigationManager Navigation

<h3>Klant Aanpassen</h3>

<EditForm Model="Klant" OnValidSubmit="Opslaan">
    <DataAnnotationsValidator />

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Achternaam: <span class="text-danger">*</span></label>
        <div class="col-md-10">
            <InputSelect @bind-Value="Klant!.Aanspreking">
                <option value="">
                    Selecteer ...
                </option>
                <option checked="@(Klant!.Aanspreking == "Dhr.")"
                        value="Dhr.">
                    Dhr.
                </option>
                <option checked="@(Klant!.Aanspreking == "Mevr.")"
                        value="Mevr.">
                    Mevr.
                </option>
                <option checked="@(Klant!.Aanspreking == "Jufr.")"
                        value="Jufr.">
                    Jufr.
                </option>
            </InputSelect>
            <ValidationMessage For="@(() => Klant.Aanspreking)" />
        </div>
    </div>
    
    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Voornaam: <span class="text-danger">*</span></label>
        <div class="col-md-10">
            <TextInput @bind-Value="@Klant.Voornaam" />
            <ValidationMessage For="@(() => Klant.Voornaam)" />
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Achternaam: <span class="text-danger">*</span></label>
        <div class="col-md-10">
            <TextInput @bind-Value="@Klant.Achternaam" />
            <ValidationMessage For="@(() => Klant.Achternaam)" />
        </div>
    </div>



    <div class="row">
        <div class="col-md-12 text-right">
            <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" Class="float-end" @onclick="Annuleer">Annuleer</Button>
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Class="float-end me-2">Submit</Button>
        </div>
    </div>

</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm] private ParticuliereKlant Klant { get; set; } = new()
    {
        Aanspreking = null,
        Voornaam = null,
        Achternaam = null       
    };

    protected override async Task OnInitializedAsync()
    {
        Klant = await ParticuliereKlantService.GetAsync(Id);
        base.OnInitialized();   
    }

    private async Task Opslaan()
    {
        await ParticuliereKlantService.UpdateAsync(Klant);
        Navigation.NavigateTo("/KlantenOverzicht");
    }

    private void Annuleer()
    {
        Navigation.NavigateTo("/KlantenOverzicht");
    }
}