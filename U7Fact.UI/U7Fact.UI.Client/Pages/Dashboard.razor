@page "/"

@using U7Fact.Model
@using BlazorBootstrap
@using U7Fact.Services.Contracts
@inject IKlantService KlantService
@inject NavigationManager Navigation

<PageTitle>U7Fact - Offerte- en factucturatie - Web App (.NET 9)</PageTitle>

<!-- KNOPPEN -->
<div class="d-flex justify-content-start flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 gap-3">    
    <!--KLANT-->
    <a href="#" class="text-decoration-none" @onclick="@(() => Navigation.NavigateTo("klantaanmaken"))">
        <Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
            <img class="rounded-top mx-auto d-block" src="/img/klant.png" alt="Klant"
                 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -35px;" />

            <CardBody Class="p-2">
                <p class="m-0 p-0" style="font-size: 12px; color: black;">
                    Nieuwe Klant
                </p>
            </CardBody>
        </Card>
    </a>
    <!--OFFERTE-->
    <a href="#" class="text-decoration-none" @onclick="@(() => Navigation.NavigateTo("offerteaanmaken"))">
        <Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
            <img class="rounded-top mx-auto d-block" src="/img/offerte.png" alt="offerte"
                 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -35px;" />

            <CardBody Class="p-2">
                <p class="m-0 p-0" style="font-size: 12px; color: black;">
                    Nieuwe offerte
                </p>
            </CardBody>
        </Card>
    </a>
    <!--Factuur-->
    <a href="#" class="text-decoration-none">
        <Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
            <img class="rounded-top mx-auto d-block" src="/img/verkoopfactuur.png" alt="factuur"
                 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -35px;" />

            <CardBody Class="p-2">
                <p class="m-0 p-0" style="font-size: 12px; color: black;">
                    Nieuwe factuur
                </p>
            </CardBody>
        </Card>
    </a>
    <!--Leverancier-->
    <a href="#" class="text-decoration-none">
        <Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
            <img class="rounded-top mx-auto d-block" src="/img/leverancier.png" alt="leverancier"
                 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -45px;" />

            <CardBody Class="p-2">
                <p class="m-0 p-0" style="font-size: 12px; color: black;">
                    Nieuwe leverancier
                </p>
            </CardBody>
        </Card>
    </a>
    <!--Inkoopfactuur-->
    <a href="#" class="text-decoration-none">
        <Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
            <img class="rounded-top mx-auto d-block" src="/img/inkoopfactuur.png" alt="inkoopfactuur"
                 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -45px;" />

            <CardBody Class="p-2">
                <p class="m-0 p-0" style="font-size: 12px; color: black;">
                    Nieuw aankoopfactuur
                </p>
            </CardBody>
        </Card>
    </a>
</div>

<!-- warnings -->

<Alert Color="AlertColor.Danger" Dismissable="true">
	De afzender "onyx-projects.be" kan niet worden gevalideerd. Uw e-mails worden nog via de standaard U7Fact methode verstuurd. <a href="#" class="alert-link">klik hier voor de instellingen. </a>
</Alert>

<!-- Subhoofding groot -->
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
	<h4 class="h4">Openstaande facturen (0)</h4>
	<div class="btn-toolbar mb-2 mb-md-0">
		Totaal: € 400,00 excl. BTW / € 454,00 incl. BTW <!-- aan te passen naar lijst -->				
	</div>
</div>

<!-- Overzicht tabel -->
<Grid TItem="Klant"
      Class="table table-hover table-bordered"
      Style="--bb-table-selected-row-color: #fff;--bb-table-selected-row-background-color: #4c0bce;--bb-table-selected-row-hover-color: #fff;--bb-table-selected-row-hover-background-color: #4c0bce;"
      DataProvider="KlantenDataProvider"
      AllowPaging="true"
      PageSize="10"
      AllowSorting="true"
      Responsive="true">

    <GridColumns>
        <GridColumn TItem="Klant" HeaderText="Klantnr." PropertyName="Klantnummer" SortKeySelector="item => item.Klantnummer">
            <Button Color="ButtonColor.Link" @onclick="@(() => KlantBekijken(context.Id))">
                @context.Klantnummer
            </Button>
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Naam" PropertyName="Naam" SortKeySelector="item => item.Achternaam">
            @context.Achternaam, @context.Voornaam
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Email-adres" PropertyName="Email">
            @context.Email
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Gsmnummer" PropertyName="Gsmnummer">
            @context.Gsmnummer
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Openstaand bedrag" PropertyName="Openstaand bedrag">
            € 0,00
        </GridColumn>
    </GridColumns>

</Grid>



@code {
    private List<Klant> Klanten { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        Klanten = await KlantService.GetAsync();
    }

    private async Task<GridDataProviderResult<Klant>> KlantenDataProvider(GridDataProviderRequest<Klant> request)
    {
        if (Klanten is null || !Klanten.Any()) // pull employees only one time for client-side filtering, sorting, and paging
            return await Task.FromResult(new GridDataProviderResult<Klant> { Data = new List<Klant>(), TotalCount = 0 });

        return await Task.FromResult(request.ApplyTo(Klanten));
    }

    private void KlantAanpassen(int id)
    {
        Navigation.NavigateTo($"klantaanpassen/{id}");
    }

    private void KlantBekijken(int id)
    {
        Navigation.NavigateTo($"klantbekijken/{id}");
    }
}