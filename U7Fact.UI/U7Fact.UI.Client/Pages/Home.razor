@page "/home"

@using U7Fact.Model
@using BlazorBootstrap
@using U7Fact.Services.Contracts
@inject IParticuliereKlantService ParticuliereKlantService
@inject NavigationManager Navigation


<PageTitle>U7Fact - Web App (.NET 9) - Offerte- en factucturatie</PageTitle>


<!-- Hoofding groot met lijn onderaan -->
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
	<h1 class="h2">Klant aanmaken</h1>
	<div class="btn-toolbar mb-2 mb-md-0">		
		<button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle">			
			PK10001
		</button>
	</div>
</div>

<!-- Tabbladen klant aanmaken -->
<EditForm Model="Klant" OnValidSubmit="Opslaan">
    <DataAnnotationsValidator />
    <ValidationSummary />
<Tabs EnableFadeEffect="true">
	<Tab Active="true">
		<TitleTemplate>
			<Icon Name="IconName.HouseFill" /> Algemeen
		</TitleTemplate>
		<Content>
			<div class="container-fluid py-4 border border-top-0">
				<!--Bovenste container klantgegevens en contactgegevens-->
				<div class="row mb-4">
					<!--LINKER KOLOM-->
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-3">
							<div class="col-12 align-content-center border-bottom">
								<h4>Klantgegevens</h4>
							</div>								
						</div>
						<!--Klantnummer-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Klantnummer</h7>
							</div>
							<div class="col-7 align-content-center">
								<TextInput @bind-Value="@Klant.Klantnummer"/>
							</div>
						</div>
						<!--Contactpersoon-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Contactpersoon</h7>
							</div>
							<div class="col-2 align-content-center">
								<InputSelect id="aanspreking" class="form-select" @bind-Value="@Klant!.Aanspreking">
										<option value="">
											Selecteer ...
										</option>
										<option checked="@(Klant!.Aanspreking == "Dhr.")"
												value="Dhr.">
											Dhr.
										</option>
										<option checked="@(Klant!.Aanspreking == "Mevr.")"
												value="Mevr.">
											Mevr.
										</option>
										<option checked="@(Klant!.Aanspreking == "Jufr.")"
												value="Jufr.">
											Jufr.
										</option>
								</InputSelect>
									<ValidationMessage For="@(() => Klant.Aanspreking)" />
							</div>
							<div class="col-2 align-content-center">
								<InputText id="voornaam" class="form-control" placeholder="Voornaam" @bind-Value="@Klant.Voornaam" />
									<ValidationMessage For="@(() => Klant.Voornaam)" />
							</div>
							<div class="col-3 align-content-center">
								<InputText id="achternaam" class="form-control" placeholder="Achternaam" @bind-Value="@Klant.Achternaam" />
									<ValidationMessage For="@(() => Klant.Achternaam)" />
							</div>
						</div>
						<!--Adres-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Adres</h7>
							</div>
							<div class="col-5 align-content-center">
								<InputText id="straatnaam" class="form-control" placeholder="Straatnaam" @bind-Value="@Klant.Straatnaam" />
							</div>
							<div class="col-2 align-content-center">
								<InputText id="huisnummer" class="form-control" placeholder="Nr." @bind-Value="@Klant.Huisnummer" />
							</div>
						</div>
						<!--postcode en gemeente-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Postcode en plaats</h7>
							</div>
							<div class="col-2 align-content-center">
								<InputText id="postcode" class="form-control" placeholder="Postcode" @bind-Value="@Klant.Postcode" />
							</div>
							<div class="col-5 align-content-center">
								<InputText id="gemeente" class="form-control" placeholder="Gemeente" @bind-Value="@Klant.Gemeente" />
							</div>
						</div>
						<!--Contactpersoon-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Land</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputSelect id="land" class="form-select" @bind-Value="@Klant.Land">
										<option value="">
											Selecteer ...
										</option>
										<option checked="@(Klant!.Land == "België")"
												value="België.">
											België
										</option>
										<option checked="@(Klant!.Land == "Nederland")"
												value="Nederland">
											Nederland
										</option>
								</InputSelect>
							</div>
						</div>

					</div>
					<!--RECHTER KOLOM-->
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-2">
							<div class="col-8 align-content-center">
								<h4>Contactgegevens</h4>
							</div>
						</div>
						<!--Email-->
						<div class="row mb-1">
							<div class="col-3 align-content-center">
								<h7>E-mailadres</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputText id="email" class="form-control" placeholder="Geef een geldig mailadres in." @bind-Value="@Klant.Email" />
									@* <ValidationMessage For="@(() => Klant.Email)" /> *@
							</div>
						</div>
						<!--Telefoon 1-->
						<div class="row mb-1">
							<div class="col-3 align-content-center">
								<h7>Telefoon</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputText id="telefoon" class="form-control" placeholder="Telefoonnummer" @bind-Value="@Klant.Telefoonnummer" />
							</div>
						</div>
						<!--Gsm-->
						<div class="row mb-1">
							<div class="col-3 align-content-center">
								<h7>Gsmnummer</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputText id="gsm" class="form-control" placeholder="Gsm nummer" @bind-Value="@Klant.Gsmnummer" />
							</div>
						</div>

					</div>
				</div>
				<!--Onderste container klantgroepen en extra contactpersonen-->
				<div class="row mb-4">
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-2">
							<div class="col-8 align-content-center">
								<h4>Klantgroepen</h4>
							</div>
						</div>
						<!--HIER MOET EEN LIJST VAN CHECKBOXEN KOMEN OM TE KIEZEN UIT DE KLANTGROEPEN!!!-->

					</div>
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-2">
							@if (isVisible)
							{
								@* <div class="mb-5">
									<div class="row mb-2">
										<div class="col-8 align-content-center">
											<h4>Standaard contactpersonen</h4>
										</div>
									</div>
									<!--Facturen-->
									<div class="row mb-1">
										<div class="col-3 align-content-center">
											<h7>Facturen</h7>
										</div>
										<div class="col-7 align-content-center">
											<InputSelect id="Verzendinfo" class="form-select" @bind-Value="@land">
												<option value="Standaard contact">Standaard contact</option>
												<option value="Extra contact">Extra contact</option>
												<option value="Beide">Beide</option>
											</InputSelect>
											
										</div>
									</div>
									<div class="row mb-1">
										<div class="col-3 align-content-center">
											<h7>Offertes</h7>
										</div>
										<div class="col-7 align-content-center">
											<InputSelect id="Verzendinfo" class="form-select" @bind-Value="@land">
												<option value="Standaard contact">Standaard contact</option>
												<option value="Extra contact">Extra contact</option>
												<option value="Beide">Beide</option>
											</InputSelect>
											
										</div>
									</div>
								</div> *@

							}
							<div class="col-8 align-content-center">
								<h4>Extra contactpersonen</h4>
							</div>
							@if (isVisible)
							{
								<div class="row mb-2">
									<div class="col-3 align-content-center">
										<h7>Contactpersoon</h7>
									</div>
									<div class="col-2 align-content-center">
										<InputSelect id="aanspreking" class="form-select" @bind-Value="@Klant.ExtraAanspreking">
												<option value="">
													Selecteer ...
												</option>
												<option checked="@(Klant!.Aanspreking == "Dhr.")"
														value="Dhr.">
													Dhr.
												</option>
												<option checked="@(Klant!.Aanspreking == "Mevr.")"
														value="Mevr.">
													Mevr.
												</option>
												<option checked="@(Klant!.Aanspreking == "Jufr.")"
														value="Jufr.">
													Jufr.
												</option>
										</InputSelect>
											<ValidationMessage For="@(() => Klant.ExtraAanspreking)" />
									</div>
									<div class="col-2 align-content-center">
										<InputText id="voornaam" class="form-control" placeholder="Voornaam" @bind-Value="@Klant.ExtraVoornaam" />
										@* <ValidationMessage For="() => NieuwePKlantModel.Voornaam" /> *@
									</div>
									<div class="col-3 align-content-center">
										<InputText id="achternaam" class="form-control" placeholder="Achternaam" @bind-Value="@Klant.ExtraAchternaam" />
										@* <ValidationMessage For="() => NieuwePKlantModel.Achternaam" /> *@
									</div>
								</div>
								<!-- Extra email -->
								<div class="row mb-1">
									<div class="col-3 align-content-center">
										<h7>E-mailadres</h7>
									</div>
									<div class="col-7 align-content-center">
										<InputText id="email" class="form-control" placeholder="Geef een geldig mailadres in." @bind-Value="@Klant.ExtraEmail" />
										@* <ValidationMessage For="() => NieuwePKlantModel.Email" /> *@
									</div>
								</div>
								<!-- Extra gsmnummer -->
								<div class="row mb-1">
									<div class="col-3 align-content-center">
										<h7>Gsmnummer</h7>
									</div>
									<div class="col-7 align-content-center">
										<InputText id="email" class="form-control" placeholder="Geef een geldig gsmnummer in." @bind-Value="@Klant.ExtraGsmnummer" />
										@* <ValidationMessage For="() => NieuwePKlantModel.Email" /> *@
									</div>
								</div>
								<!-- Extra telefoonnummer -->
								<div class="row mb-1">
									<div class="col-3 align-content-center">
										<h7>Telefoonnummer</h7>
									</div>
									<div class="col-7 align-content-center">
										<InputText id="email" class="form-control" placeholder="Geef een geldig telefoonnummer in." @bind-Value="@Klant.ExtraTelefoonnummer" />
										@* <ValidationMessage For="() => NieuwePKlantModel.Email" /> *@
									</div>
								</div>
							}
						</div>
						@if (!isVisible)
						{
							<p>Te gebruiken voor afwijkende facturatiegegevens en contactpersonen waar u een offerte/factuur naartoe wilt sturen.</p>
						}

						@if (!isVisible)
						{
							<!-- Knop om extra contactpersoon toe te voegen -->
							<button type="button" class="btn" @onclick="ToggleVisibility">+ Contactpersoon toevoegen</button>
						}

					</div>
				</div>
			</div>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PersonFill" /> Instellingen
		</TitleTemplate>
		<Content>
			<p class="mt-3">This is the placeholder content for the <b>Instellingen</b> tab.</p>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PhoneFill" /> Bank en machtigingen
		</TitleTemplate>
		<Content>
			<p class="mt-3">This is the placeholder content for the <b>Bank en machtigingen</b> tab.</p>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PhoneFill" /> Bijlage(n)
		</TitleTemplate>
		<Content>
			<p class="mt-3">This is the placeholder content for the <b>Bijlage(n)</b> tab.</p>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PhoneFill" /> Interne notities
		</TitleTemplate>
		<Content>				
			<div class="container-fluid py-4 border border-top-0">
				<div class="form-group">
					<label class="mb-4">Indien u extra informatie over de debiteur wilt invoeren kunt u dat hier doen.</label>
					
					<InputTextArea id="opmerkingen" class="form-control" rows="15" @bind-Value="@Klant.InterneNotitie" />
				</div>
			</div>
		</Content>
	</Tab>	
</Tabs>
<div class="d-flex justify-content-end gap-3 flex-wrap flex-md-nowrap align-items-center p-3 pb-2 mb-3">
	<Button Color="ButtonColor.Danger" Outline="true" Type="ButtonType.Button" @onclick="Annuleer"> Annuleer </Button>
	<Button Color="ButtonColor.Success" Outline="true" Type="ButtonType.Submit"> Opslaan </Button>
	@* <button class="btn btn-danger" Outline="true">Annuleren</button>
	<button type="submit" class="btn btn-success" Outline="true">Opslaan</button> *@
</div>
</EditForm>


@code {

	// [Parameter]
	// public int Id { get; set; }

	[SupplyParameterFromForm]
	private ParticuliereKlant Klant { get; set; } = new()
		{
			Aanspreking = null,
			Voornaam = null,
			Achternaam = null,
		};

	// protected override async Task OnInitializedAsync()
	// {
	// 	Klant = await ParticuliereKlantService.GetAsync(Id);
	// 	base.OnInitialized();
	// }

	private async Task Opslaan()
	{
		await ParticuliereKlantService.AddAsync(Klant);
		// Navigation.NavigateTo("/KlantenBeheer/KlantenOverzicht");
	}

	private void Annuleer()
	{
		Navigation.NavigateTo("/");
	}


	// KNOP OM GEDEELTE ZICHTBAAR TE MAKEN
	private bool isVisible = false;

	private void ToggleVisibility()
	{
		isVisible = !isVisible;
	}
}