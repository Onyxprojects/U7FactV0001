@page "/"

<PageTitle>U7Fact - Web App (.NET 9) - Offerte- en factucturatie</PageTitle>


<!-- Hoofding groot met lijn onderaan -->
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
	<h1 class="h2">Klant aanmaken</h1>
	<div class="btn-toolbar mb-2 mb-md-0">
		@* <div class="btn-group me-2">
			<button type="button" class="btn btn-sm btn-outline-secondary">Share</button>
			<button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
		</div> *@
		<button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle">			
			PK10001
		</button>
	</div>
</div>

<!-- Tabbladen klant aanmaken -->
<Tabs EnableFadeEffect="true">
	<Tab Active="true">
		<TitleTemplate>
			<Icon Name="IconName.HouseFill" /> Algemeen
		</TitleTemplate>
		<Content>
			<div class="container-fluid py-4 border border-top-0">
				<!--Bovenste container klantgegevens en contactgegevens-->
				<div class="row mb-4">
					<!--LINKER KOLOM-->
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-3">
							<div class="col-12 align-content-center border-bottom">
								<h4>Klantgegevens</h4>
							</div>								
						</div>
						<!--Klantnummer-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Klantnummer</h7>
							</div>
							<div class="col-7 align-content-center">
								<TextInput @bind-Value="@klantnummer" Disabled />
							</div>
						</div>
						<!--Contactpersoon-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Contactpersoon</h7>
							</div>
							<div class="col-2 align-content-center">
								<InputSelect id="aanspreking" class="form-select" @bind-Value="@aanspreking">
									<option value="Dhr.">Dhr.</option>
									<option value="Mevr.">Mevr.</option>
									<option value="Fam.">Fam.</option>
									<option value="Afd..">Afd.</option>
								</InputSelect>
								@* <ValidationMessage For="() => NieuwePKlantModel.Aanspreking" /> *@
							</div>
							<div class="col-2 align-content-center">
								<InputText id="voornaam" class="form-control" placeholder="Voornaam" @bind-Value="@voornaam" />
								@* <ValidationMessage For="() => NieuwePKlantModel.Voornaam" /> *@
							</div>
							<div class="col-3 align-content-center">
								<InputText id="achternaam" class="form-control" placeholder="Achternaam" @bind-Value="@achternaam" />
								@* <ValidationMessage For="() => NieuwePKlantModel.Achternaam" /> *@
							</div>
						</div>
						<!--Adres-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Adres</h7>
							</div>
							<div class="col-5 align-content-center">
								<InputText id="straatnaam" class="form-control" placeholder="Straatnaam" @bind-Value="@straatnaam" />
							</div>
							<div class="col-2 align-content-center">
								<InputText id="huisnummer" class="form-control" placeholder="Nr." @bind-Value="@huisnummer" />
							</div>
						</div>
						<!--postcode en gemeente-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Postcode en plaats</h7>
							</div>
							<div class="col-2 align-content-center">
								<InputText id="postcode" class="form-control" placeholder="Postcode" @bind-Value="@postcode" />
							</div>
							<div class="col-5 align-content-center">
								<InputText id="gemeente" class="form-control" placeholder="Gemeente" @bind-Value="@gemeente" />
							</div>
						</div>
						<!--Contactpersoon-->
						<div class="row mb-2">
							<div class="col-3 align-content-center">
								<h7>Land</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputSelect id="land" class="form-select" @bind-Value="@land">
									<option value="België">België</option>
									<option value="Nederland">Nederland</option>
								</InputSelect>
							</div>
						</div>

					</div>
					<!--RECHTER KOLOM-->
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-2">
							<div class="col-8 align-content-center">
								<h4>Contactgegevens</h4>
							</div>
						</div>
						<!--Email-->
						<div class="row mb-1">
							<div class="col-3 align-content-center">
								<h7>E-mailadres</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputText id="email" class="form-control" placeholder="Geef een geldig mailadres in." @bind-Value="@email" />
								@* <ValidationMessage For="() => NieuwePKlantModel.Email" /> *@
							</div>
						</div>
						<!--Telefoon 1-->
						<div class="row mb-1">
							<div class="col-3 align-content-center">
								<h7>Telefoon</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputText id="telefoon" class="form-control" placeholder="Telefoonnummer" @bind-Value="@telefoonnummer" />
							</div>
						</div>
						<!--Gsm-->
						<div class="row mb-1">
							<div class="col-3 align-content-center">
								<h7>Gsmnummer</h7>
							</div>
							<div class="col-7 align-content-center">
								<InputText id="gsm" class="form-control" placeholder="Gsm nummer" @bind-Value="@gsmnummer" />
							</div>
						</div>

					</div>
				</div>
				<!--Onderste container klantgroepen en extra contactpersonen-->
				<div class="row mb-4">
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-2">
							<div class="col-8 align-content-center">
								<h4>Klantgroepen</h4>
							</div>
						</div>
						<!--HIER MOET EEN LIJST VAN CHECKBOXEN KOMEN OM TE KIEZEN UIT DE KLANTGROEPEN!!!-->

					</div>
					<div class="col-md-6">
						<!--HOOFDING + TYPE-->
						<div class="row mb-2">
							<div class="col-8 align-content-center">
								<h4>Extra contactpersonen</h4>
							</div>
						</div>
						@if (!isVisible)
						{
							<p>Te gebruiken voor afwijkende facturatiegegevens en contactpersonen waar u een offerte/factuur naartoe wilt sturen.</p>
						}
						@if (isVisible)
						{

							<div class="row mb-2">
								<div class="col-3 align-content-center">
									<h7>Contactpersoon</h7>
								</div>
								<div class="col-2 align-content-center">
									<InputSelect id="aanspreking" class="form-select" @bind-Value="@aanspreking">
										<option value="Dhr.">Dhr.</option>
										<option value="Mevr.">Mevr.</option>
										<option value="Fam.">Fam.</option>
										<option value="Afd..">Afd.</option>
									</InputSelect>
									@* <ValidationMessage For="() => NieuwePKlantModel.Aanspreking" /> *@
								</div>
								<div class="col-2 align-content-center">
									<InputText id="voornaam" class="form-control" placeholder="Voornaam" @bind-Value="@voornaam" />
									@* <ValidationMessage For="() => NieuwePKlantModel.Voornaam" /> *@
								</div>
								<div class="col-3 align-content-center">
									<InputText id="achternaam" class="form-control" placeholder="Achternaam" @bind-Value="@achternaam" />
									@* <ValidationMessage For="() => NieuwePKlantModel.Achternaam" /> *@
								</div>
							</div>
							<div class="row mb-2">
								<div class="col-3 align-content-center">
									<h7>E-mailadres</h7>
								</div>
								<div class="col-7 align-content-center">
									<InputText id="email" class="form-control" placeholder="Geef een geldig mailadres in." @bind-Value="@email" />
									@* <ValidationMessage For="() => NieuwePKlantModel.Email" /> *@
								</div>
							</div>
						}


						<!-- Knop om extra contactpersoon toe te voegen -->
						<button type="button" class="btn btn-primary" @onclick="ToggleVisibility">+ Contactpersoon toevoegen</button>


					</div>
				</div>
			</div>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PersonFill" /> Instellingen
		</TitleTemplate>
		<Content>
			<p class="mt-3">This is the placeholder content for the <b>Instellingen</b> tab.</p>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PhoneFill" /> Bank en machtigingen
		</TitleTemplate>
		<Content>
			<p class="mt-3">This is the placeholder content for the <b>Bank en machtigingen</b> tab.</p>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PhoneFill" /> Bijlage(n)
		</TitleTemplate>
		<Content>
			<p class="mt-3">This is the placeholder content for the <b>Bijlage(n)</b> tab.</p>
		</Content>
	</Tab>
	<Tab>
		<TitleTemplate>
			<Icon Name="IconName.PhoneFill" /> Interne notities
		</TitleTemplate>
		<Content>				
			<div class="container-fluid py-4 border border-top-0">
				<div class="form-group">
					<label class="mb-4">Indien u extra informatie over de debiteur wilt invoeren kunt u dat hier doen.</label>
					<textarea class="form-control" rows="15"></textarea>
					<InputTextArea id="opmerkingen" class="form-control" rows="5" placeholder="Enter ..." @bind-Value="@opmerkingen" />
				</div>
			</div>
		</Content>
	</Tab>	
</Tabs>
<div>
	<button type="submit" class="btn btn-primary float-right">Opslaan</button>
</div>





@code {
	private string? klantnummer = null;
	private string? aanspreking = null;
	private string? voornaam = null;
	private string? achternaam = null;
	private string? straatnaam = null;
	private string? huisnummer = null;
	private string? postcode = null;
	private string? gemeente = null;
	private string? land = null;
	private string? email = null;
	private string? telefoonnummer = null;
	private string? gsmnummer = null;
	private string? opmerkingen = null;

	private bool isVisible = false;

	private void ToggleVisibility()
	{
		isVisible = !isVisible;
	}
}