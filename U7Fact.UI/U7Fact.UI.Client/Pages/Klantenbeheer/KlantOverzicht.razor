@page "/klantenoverzicht"

@using U7Fact.Model
@using BlazorBootstrap
@using U7Fact.Services.Contracts
@inject IKlantService KlantService;
@inject NavigationManager Navigation


<!-- Hoofding groot met lijn onderaan -->
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Klanten overzicht</h1>
    <div class="btn-toolbar mb-2 mb-md-0 align-items-center">
        Totaal: 1        
    </div>
</div>

<!-- balk met knoppen -->
<div class="d-flex justify-content-start flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 gap-2">    
    <div class="btn-toolbar mb-2 mb-md-0 align-items-center">        
        <Button Color="ButtonColor.Primary" @onclick="@(() => Navigation.NavigateTo("klantaanmaken"))">Nieuwe klant</Button>
    </div>    
</div>

<!-- Overzicht tabel -->


<Grid TItem="Klant"
      Class="table table-hover table-bordered"
      Style="--bb-table-selected-row-color: #fff;--bb-table-selected-row-background-color: #4c0bce;--bb-table-selected-row-hover-color: #fff;--bb-table-selected-row-hover-background-color: #4c0bce;"
      DataProvider="KlantenDataProvider"
      AllowPaging="true"
      PageSize="10"
      AllowSorting="true"
      Responsive="true">

    <GridColumns>
        <GridColumn TItem="Klant" HeaderText="Klantnr." PropertyName="Klantnummer" SortKeySelector="item => item.Klantnummer">
            <Button Color="ButtonColor.Link" @onclick="@(() => KlantBekijken(context.Id))">
                @context.Klantnummer
            </Button>
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Naam" PropertyName="Naam" SortKeySelector="item => item.Achternaam">            
                @context.Achternaam, @context.Voornaam            
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Email-adres" PropertyName="Email">
            @context.Email
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Gsmnummer" PropertyName="Gsmnummer">
            @context.Gsmnummer
        </GridColumn>
        <GridColumn TItem="Klant" HeaderText="Openstaand bedrag" PropertyName="Openstaand bedrag">
            € 0,00
        </GridColumn>
    </GridColumns>

</Grid>


@code {
    private List<Klant> Klanten { get; set; } = new();
    

    protected override async Task OnInitializedAsync()
    {
        Klanten = await KlantService.GetAsync();
    }

    private async Task<GridDataProviderResult<Klant>> KlantenDataProvider(GridDataProviderRequest<Klant> request)
    {
        if (Klanten is null || !Klanten.Any()) // pull employees only one time for client-side filtering, sorting, and paging
            return await Task.FromResult(new GridDataProviderResult<Klant> { Data = new List<Klant>(), TotalCount = 0 });

        return await Task.FromResult(request.ApplyTo(Klanten));
    }

    private void KlantAanpassen(int id)
    {
        Navigation.NavigateTo($"klantaanpassen/{id}");
    }

    private void KlantBekijken(int id)
    {
        Navigation.NavigateTo($"klantbekijken/{id}");
    }
}