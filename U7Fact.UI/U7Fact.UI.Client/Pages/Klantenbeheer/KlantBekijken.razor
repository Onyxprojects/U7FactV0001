@page "/klantbekijken/{Id:int}"

@using U7Fact.Model
@using BlazorBootstrap
@using U7Fact.Services.Contracts
@inject IKlantService KlantService;
@inject NavigationManager Navigation



<!-- Tabbladen klant aanmaken -->
<EditForm Model="Klant" OnValidSubmit="Opslaan">
	<DataAnnotationsValidator />
	<ValidationSummary />
	<!-- Hoofding groot met lijn onderaan -->
	<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
		<h4 class="h4"><strong>Klant @Klant.Voornaam @Klant.Achternaam</strong></h4>
		<div class="btn-toolbar mb-2 mb-md-0">
			<button type="button" class="btn btn-sm btn-outline-secondary">
				@Klant.Klantnummer
			</button>
		</div>
	</div>
	<div class="d-flex justify-content-start flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 gap-3">

		<!--OFFERTE-->
		<a href="#" class="text-decoration-none" @onclick="@(() => Navigation.NavigateTo("offerteaanmaken"))">
			<Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
				<img class="rounded-top mx-auto d-block" src="/img/offerte.png" alt="offerte"
					 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -35px;" />

				<CardBody Class="p-2">
					<p class="m-0 p-0" style="font-size: 12px; color: black;">
						Nieuwe offerte
					</p>
				</CardBody>
			</Card>
		</a>
		<!--Factuur-->
		<a href="#" class="text-decoration-none">
			<Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
				<img class="rounded-top mx-auto d-block" src="/img/verkoopfactuur.png" alt="factuur"
					 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -35px;" />

				<CardBody Class="p-2">
					<p class="m-0 p-0" style="font-size: 12px; color: black;">
						Nieuwe factuur
					</p>
				</CardBody>
			</Card>
		</a>
		<!--Abonnement-->
		<a href="#" class="text-decoration-none">
			<Card Class="mb-4 text-center shadow-sm border" Style="width: 115px; height: 100px;">
				<img class="rounded-top mx-auto d-block" src="/img/inkoopfactuur.png" alt="inkoopfactuur"
					 style="width: 110px; height: 100px; object-fit: contain; margin-bottom: -35px;" />

				<CardBody Class="p-2">
					<p class="m-0 p-0" style="font-size: 12px; color: black;">
						Abonnement
					</p>
				</CardBody>
			</Card>
		</a>
	</div>

	<Tabs EnableFadeEffect="true">
		<Tab Active="true">
			<TitleTemplate>
				<Icon Name="IconName.HouseFill" /> Algemeen
			</TitleTemplate>
			<Content>
				<div class="container-fluid py-4 border border-top-0">
					<!--Bovenste container klantgegevens en contactgegevens-->
					<div class="row mb-4">
						<!--LINKER KOLOM-->
						<div class="col-md-6">
							<!--HOOFDING + TYPE-->
							<div class="row mb-3">
								<div class="col-12 align-content-center border-bottom">
									<h4>Klantgegevens</h4>
								</div>
							</div>
							<!--Klantnummer-->
							<div class="row mb-2">
								<div class="col-3 align-content-center">
									<h7>Klantnummer</h7>
								</div>
								<div class="col-7 align-content-center">
									@Klant.Klantnummer
								</div>
							</div>
							<!-- BEDRIJFSNAAM -->
							<div class="row mb-2">
								<!-- Bedrijfsnaam (Bepaalt automatisch het klanttype) -->
								<div class="col-3 align-content-center">
									<h7>Bedrijfsnaam</h7>
								</div>
								<div class="col-7 align-content-center">
									@Klant.Bedrijfsnaam
								</div>
							</div>

							<!-- Verborgen velden verschijnen als er een bedrijfsnaam is ingevuld -->
							@if (!string.IsNullOrWhiteSpace(Klant.Bedrijfsnaam))
							{
								<div class="row mb-2">
									<div class="col-3 align-content-center">
										<h7>BTW nummer</h7>
									</div>
									<div class="col-7 align-content-center">
										@Klant.BtwNummer
									</div>
								</div>
								<div class="row mb-2">
									<div class="col-3 align-content-center">
										<h7>KBO nummer</h7>
									</div>
									<div class="col-7 align-content-center">
										@Klant.KboNummer
									</div>
								</div>
							}
							<!--Contactpersoon-->
							<div class="row mb-2">
								<div class="col-3 align-content-center">
									<h7>Contactpersoon</h7>
								</div>
								<div class="col-7 align-content-center">
									@Klant!.Aanspreking @Klant.Voornaam @Klant.Achternaam
								</div>
							</div>
							<!--Adres-->
							<div class="row mb-2">
								<div class="col-3 align-content-center">
									<h7>Adres</h7>
								</div>
								<div class="col-7 align-content-center">
									@Klant.Straatnaam @Klant.Huisnummer
								</div>
							</div>
							<!--postcode en gemeente-->
							<div class="row mb-2">
								<div class="col-3 align-content-center">
									<h7>Postcode en plaats</h7>
								</div>
								<div class="col-7 align-content-center">
									@Klant.Postcode @Klant.Gemeente (@Klant.Land)
								</div>
							</div>

						</div>
						<!--RECHTER KOLOM-->
						<div class="col-md-6">
							<!--HOOFDING + TYPE-->
							<div class="row mb-2">
								<div class="col-8 align-content-center">
									<h4>Contactgegevens</h4>
								</div>
							</div>
							<!--Email-->
							<div class="row mb-1">
								<div class="col-3 align-content-center">
									<h7>E-mailadres</h7>
								</div>
								<div class="col-7 align-content-center">
									@Klant.Email <!-- link toevoegen om rechtsreeks te mailen of adres te kopiëren naar mailprogramma/> -->
								</div>
							</div>
							<!--Telefoon 1-->
							<div class="row mb-1">
								<div class="col-3 align-content-center">
									<h7>Telefoon</h7>
								</div>
								<div class="col-7 align-content-center">
									@Klant.Telefoonnummer
								</div>
								<!--Gsm-->
								<div class="row mb-1">
									<div class="col-3 align-content-center">
										<h7>Gsmnummer</h7>
									</div>
									<div class="col-7 align-content-center">
										@Klant.Gsmnummer
										
									</div>
								</div>
							</div>
						</div>
					</div>
					<!--Onderste container klantgroepen en extra contactpersonen-->
					<div class="row mb-4">
						<div class="col-md-6">
							<!--HOOFDING + TYPE-->
							<div class="row mb-2">
								<div class="col-8 align-content-center">
									<h4>Klantgroepen</h4>
								</div>
							</div>
							<!--HIER MOET EEN LIJST VAN CHECKBOXEN KOMEN OM TE KIEZEN UIT DE KLANTGROEPEN!!!-->

						</div>
						<div class="col-md-6">
							<!--HOOFDING + TYPE-->
							<div class="row mb-2">
								@if (isVisible)
								{
									@* <div class="mb-5">
									<div class="row mb-2">
										<div class="col-8 align-content-center">
											<h4>Standaard contactpersonen</h4>
										</div>
									</div>
									<!--Facturen-->
									<div class="row mb-1">
										<div class="col-3 align-content-center">
											<h7>Facturen</h7>
										</div>
										<div class="col-7 align-content-center">
											<InputSelect id="Verzendinfo" class="form-select" @bind-Value="@land">
												<option value="Standaard contact">Standaard contact</option>
												<option value="Extra contact">Extra contact</option>
												<option value="Beide">Beide</option>
											</InputSelect>

										</div>
									</div>
									<div class="row mb-1">
										<div class="col-3 align-content-center">
											<h7>Offertes</h7>
										</div>
										<div class="col-7 align-content-center">
											<InputSelect id="Verzendinfo" class="form-select" @bind-Value="@land">
												<option value="Standaard contact">Standaard contact</option>
												<option value="Extra contact">Extra contact</option>
												<option value="Beide">Beide</option>
											</InputSelect>

										</div>
									</div>
								</div> *@

								}
								<div class="col-8 align-content-center">
									<h4>Extra contactpersonen</h4>
								</div>
								@if (isVisible)
								{
									<div class="row mb-2">
										<div class="col-3 align-content-center">
											<h7>Contactpersoon</h7>
										</div>
										<div class="col-2 align-content-center">
											<InputSelect id="aanspreking" class="form-select" @bind-Value="@Klant.ExtraAanspreking" Disabled>
												<option value="">Selecteer ...</option>
												<option value="Dhr.">Dhr.</option>
												<option value="Mevr.">Mevr.</option>
												<option value="Jufr.">Jufr.</option>
												<option value="Fam.">Fam.</option>
												<option value="Meester">Meester</option>
												<option value="Advocaat">Advocaat</option>
											</InputSelect>
										</div>
										<div class="col-2 align-content-center">
											<InputText id="voornaam" class="form-control" placeholder="Voornaam" @bind-Value="@Klant.ExtraVoornaam" Disabled />
										</div>
										<div class="col-3 align-content-center">
											<InputText id="achternaam" class="form-control" placeholder="Achternaam" @bind-Value="@Klant.ExtraAchternaam" Disabled />
										</div>
									</div>
									<!-- Extra email -->
									<div class="row mb-1">
										<div class="col-3 align-content-center">
											<h7>E-mailadres</h7>
										</div>
										<div class="col-7 align-content-center">
											<InputText id="email" class="form-control" placeholder="Geef een geldig mailadres in." @bind-Value="@Klant.ExtraEmail" Disabled />
											<ValidationMessage For="() => Klant.ExtraEmail" />
										</div>
									</div>
									<!-- Extra gsmnummer -->
									<div class="row mb-1">
										<div class="col-3 align-content-center">
											<h7>Gsmnummer</h7>
										</div>
										<div class="col-7 align-content-center">
											<InputText id="email" class="form-control" placeholder="Geef een geldig gsmnummer in." @bind-Value="@Klant.ExtraGsmnummer" Disabled />
											<ValidationMessage For="() => Klant.ExtraGsmnummer" />
										</div>
									</div>
									<!-- Extra telefoonnummer -->
									<div class="row mb-1">
										<div class="col-3 align-content-center">
											<h7>Telefoonnummer</h7>
										</div>
										<div class="col-7 align-content-center">
											<InputText id="email" class="form-control" placeholder="Geef een geldig telefoonnummer in." @bind-Value="@Klant.ExtraTelefoonnummer" Disabled />
											<ValidationMessage For="() => Klant.ExtraTelefoonnummer" />
										</div>
									</div>
								}
							</div>
							@if (!isVisible)
							{
								<p>Te gebruiken voor afwijkende facturatiegegevens en contactpersonen waar u een offerte/factuur naartoe wilt sturen.</p>
							}

							@if (!isVisible)
							{
								<!-- Knop om extra contactpersoon toe te voegen -->
								<button type="button" class="btn" @onclick="ToggleVisibility">+ Contactpersoon toevoegen</button>
							}

						</div>
					</div>
				</div>
			</Content>
		</Tab>
		<Tab>
			<TitleTemplate>
				<Icon Name="IconName.PersonFill" /> Instellingen
			</TitleTemplate>
			<Content>
				<p class="mt-3">This is the placeholder content for the <b>Instellingen</b> tab.</p>
			</Content>
		</Tab>
		<Tab>
			<TitleTemplate>
				<Icon Name="IconName.PhoneFill" /> Bank en machtigingen
			</TitleTemplate>
			<Content>
				<p class="mt-3">This is the placeholder content for the <b>Bank en machtigingen</b> tab.</p>
			</Content>
		</Tab>
		<Tab>
			<TitleTemplate>
				<Icon Name="IconName.PhoneFill" /> Bijlage(n)
			</TitleTemplate>
			<Content>
				<p class="mt-3">This is the placeholder content for the <b>Bijlage(n)</b> tab.</p>
			</Content>
		</Tab>
		<Tab>
			<TitleTemplate>
				<Icon Name="IconName.PhoneFill" /> Interne notities
			</TitleTemplate>
			<Content>
				<div class="container-fluid py-4 border border-top-0">
					<div class="form-group">
						<label class="mb-4">Indien u extra informatie over de debiteur wilt invoeren kunt u dat hier doen.</label>

						<InputTextArea id="opmerkingen" class="form-control" rows="15" @bind-Value="@Klant.InterneNotitie" />
					</div>
				</div>
			</Content>
		</Tab>
	</Tabs>
	<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
		<Button Color="ButtonColor.Primary" Type="ButtonType.Submit"> Klant bewerken </Button>
		<Button Color="ButtonColor.Danger" Type="ButtonType.Button" @onclick="Annuleer"> Klant verwijderen </Button>
	</div>
</EditForm>


@code {
	[Parameter]
	public int Id { get; set; }

	[SupplyParameterFromForm]
	private Klant Klant { get; set; } = new()
		{
			Voornaam = null,
			Achternaam = null
		};

	protected override async Task OnInitializedAsync()
	{
		Klant = await KlantService.GetAsync(Id);
		base.OnInitialized();
	}

	private void Opslaan()
	{
		Navigation.NavigateTo($"klantaanpassen/{Id}");
	}

	private void Annuleer()
	{
		Navigation.NavigateTo("/klantenoverzicht");
	}

	// KNOP OM GEDEELTE ZICHTBAAR TE MAKEN
	private bool isVisible = false;

	private void ToggleVisibility()
	{
		isVisible = !isVisible;
	}
}